NODE_ENV=development
DEPLOYMENT_PROFILE=go_live
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
REDIS_URL=redis://localhost:6379
BACKGROUND_QUEUE_ENABLED=true
BACKGROUND_QUEUE_CONCURRENCY=8

API_HOST=0.0.0.0
API_PORT=4012
NEXT_PUBLIC_API_URL=http://127.0.0.1:4012/api
NEXT_PUBLIC_BUYER_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SUPPLIER_APP_URL=http://127.0.0.1:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_REQUESTS=240

AUTH_MODE=development
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRE_MFA=false
SOCIAL_AUTH_ENABLED=false
PUBLIC_DEMO_MODE=false
PUBLIC_CATALOG_ORGANIZATION_ID=00000000-0000-4000-8000-000000000030
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-000000000002
NEXT_PUBLIC_DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEMO_BUYER_ORGANIZATION_ID=00000000-0000-4000-8000-000000000030
MFA_ISSUER="DentMarket KZ"

# Generate independent production keys with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
APP_SECURITY_ENCRYPTION_KEY=

OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketplace
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-local-secret
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=
LOCAL_STORAGE_PATH=.local-storage

AV_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

OTEL_SERVICE_NAME=marketplace-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
APP_RELEASE=local

NOTIFICATION_WEBHOOK_SECRET=local-webhook-secret-at-least-32-chars
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SIGNATURE_GATEWAY_URL=
SIGNATURE_GATEWAY_TOKEN=
SIGNATURE_CALLBACK_SECRET=
PAYMENT_PROVIDER_MODE=mock
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_WEBHOOK_SECRET_EXTERNAL=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
