model Product {
  id                 String                  @id @default(uuid()) @db.Uuid
  canonicalName      String
  description        String?
  descriptionSources Json?
  slug               String                  @unique
  brandId            String?                 @db.Uuid
  manufacturerId     String?                 @db.Uuid
  manufacturerSku    String?
  gtin               String?
  baseUnitId         String?                 @db.Uuid
