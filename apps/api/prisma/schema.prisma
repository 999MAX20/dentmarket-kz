  supplier               SupplierProfile         @relation(fields: [supplierOrganizationId], references: [organizationId], onDelete: Cascade)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([supplierOrganizationId, status])
  @@index([productId, field, status])
}

model ProductMedia {
