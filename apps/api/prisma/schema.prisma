  validTo        DateTime?
  fromProduct    Product               @relation("ProductRelationFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct      Product               @relation("ProductRelationTo", fields: [toProductId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([fromProductId, toProductId, type])
  @@index([fromProductId, type, status])
  @@index([toProductId, type, status])
}

model ProductContentSource {
  id                     String                   @id @default(uuid()) @db.Uuid
  productId              String                   @db.Uuid
  supplierOrganizationId String?                  @db.Uuid
  field                  String
  value                  String
