model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique
  displayName              String
  status                   RecordStatus              @default(ACTIVE)
  emailVerifiedAt          DateTime?
  passwordHash             String?
  failedLoginAttempts      Int                       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  locale                   String                    @default("ru-KZ")
  memberships              OrganizationMembership[]
  mfaFactor                UserMfaFactor?
  externalIdentities       ExternalIdentity[]
  authSessions             AuthSession[]
  claimedRegistrations     RegistrationIntent[]      @relation("RegistrationClaimedBy")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  platformOfferAcceptances PlatformOfferAcceptance[]
  emailAuthTokens          EmailAuthToken[]
  pushSubscriptions        PushSubscription[]
}

model EmailAuthToken {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  tokenHash  String             @unique
  type       EmailAuthTokenType
  expiresAt  DateTime
  consumedAt DateTime?
  metadata   Json?
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([userId, type, expiresAt])
  @@index([type, consumedAt, expiresAt])
}

model UserMfaFactor {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @unique @db.Uuid
  status             MfaFactorStatus @default(PENDING)
  encryptedSecret    String
  recoveryCodeHashes String[]        @default([])
  verifiedAt         DateTime?
  lastUsedAt         DateTime?
  failedAttempts     Int             @default(0)
  lockedUntil        DateTime?
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, lockedUntil])
}

model Organization {
  id                                String                    @id @default(uuid()) @db.Uuid
  legalName                         String
  displayName                       String
  bin                               String                    @unique @db.VarChar(12)
  status                            RecordStatus              @default(ACTIVE)
  primaryIndustryId                 String?                   @db.Uuid
  version                           Int                       @default(1)
  capabilities                      OrganizationCapability[]
  primaryIndustry                   Industry?                 @relation(fields: [primaryIndustryId], references: [id], onDelete: SetNull)
  memberships                       OrganizationMembership[]
  invitations                       MembershipInvitation[]
  roles                             Role[]
  approvalPolicies                  ApprovalPolicy[]
  addresses                         Address[]
  supplierProfile                   SupplierProfile?
  buyerContractPrices               ContractPrice[]           @relation("ContractPriceBuyer")
  carts                             Cart[]                    @relation("CartBuyer")
  checkouts                         Checkout[]                @relation("CheckoutBuyer")
  buyerOrders                       SupplierOrder[]           @relation("SupplierOrderBuyer")
  supplierOrders                    SupplierOrder[]           @relation("SupplierOrderSupplier")
  paymentIntents                    PaymentIntent[]           @relation("PaymentIntentBuyer")
  paymentAllocations                PaymentAllocation[]       @relation("PaymentAllocationRecipient")
  paymentMerchants                  PaymentMerchantAccount[]  @relation("PaymentMerchantOrganization")
  ownedDocuments                    Document[]                @relation("DocumentOwner")
  signedDocuments                   DocumentSignature[]       @relation("DocumentSignerOrganization")
  credentials                       OrganizationCredential[]
  sellerChecks                      ComplianceCheck[]         @relation("ComplianceSeller")
  buyerChecks                       ComplianceCheck[]         @relation("ComplianceBuyer")
  notifications                     Notification[]
  notificationPrefs                 NotificationPreference[]
  pushSubscriptions                 PushSubscription[]
  registrationIntents               RegistrationIntent[]
  platformOfferAcceptances          PlatformOfferAcceptance[]
  supplierBuyerAgreementsAsBuyer    BuyerSupplierAgreement[]  @relation("BuyerSupplierAgreementBuyer")
  supplierBuyerAgreementsAsSupplier BuyerSupplierAgreement[]  @relation("BuyerSupplierAgreementSupplier")
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt

  @@index([displayName])
}

model RegistrationIntent {
  id                      String                     @id @default(uuid()) @db.Uuid
  email                   String
  ownerDisplayName        String
  legalName               String
  organizationDisplayName String
  bin                     String                     @db.VarChar(12)
  capability              OrganizationCapabilityType
  industryCode            String                     @default("dentistry-kz")
  status                  RegistrationIntentStatus   @default(PENDING)
  tokenHash               String                     @unique
  idempotencyKey          String                     @unique
  consentVersion          String
  termsAcceptedAt         DateTime
  privacyAcceptedAt       DateTime
  marketingConsent        Boolean                    @default(false)
  source                  String                     @default("landing")
  expiresAt               DateTime
  claimedAt               DateTime?
  claimedByUserId         String?                    @db.Uuid
  organizationId          String?                    @db.Uuid
  acceptanceIpAddress     String?
  acceptanceUserAgent     String?
  acceptanceMethod        String                     @default("REGISTRATION_FORM")
  offerDocumentHash       String                     @default("")
  evidenceSnapshot        Json?
  claimedBy               User?                      @relation("RegistrationClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  organization            Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  platformOfferAcceptance PlatformOfferAcceptance?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([email, status, expiresAt])
  @@index([bin, status])
  @@index([capability, status, createdAt])
}

model PlatformOfferAcceptance {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @unique @db.Uuid
  registrationIntentId String             @unique @db.Uuid
  userId               String             @db.Uuid
  termsVersion         String
  acceptedAt           DateTime
  ipAddress            String?
  userAgent            String?
  acceptanceMethod     String
  documentHash         String
  evidenceSnapshot     Json
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrationIntent   RegistrationIntent @relation(fields: [registrationIntentId], references: [id], onDelete: Restrict)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, acceptedAt])
  @@index([termsVersion, acceptedAt])
}

model OrganizationCapability {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  capability     OrganizationCapabilityType
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())

  @@unique([organizationId, capability])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  branchId       String?          @db.Uuid
  departmentId   String?          @db.Uuid
  title          String?
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime         @default(now())
  acceptedAt     DateTime?
  blockedAt      DateTime?
  isPrimary      Boolean          @default(false)
  accessScope    Json?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  code           String
  name           String
  isSystem       Boolean          @default(false)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    MembershipRole[]
  invitations    InvitationRole[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
}

model MembershipInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?          @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          InvitationRole[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
}

model InvitationRole {
  invitationId String               @db.Uuid
  roleId       String               @db.Uuid
  invitation   MembershipInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
