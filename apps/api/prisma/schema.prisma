  @@index([reviewId, createdAt])
}

model SupplierTrustMetricEvent {
  id                     String    @id @default(uuid()) @db.Uuid
  supplierOrganizationId String    @db.Uuid
  metricCode             String
  value                  Decimal   @db.Decimal(8, 5)
  weight                 Decimal   @default(1) @db.Decimal(8, 5)
  categoryId             String?   @db.Uuid
  cityId                 String?   @db.Uuid
  fulfillmentType        String?
  sourceEntityType       String
  sourceEntityId         String
  occurredAt             DateTime
  disputed               Boolean   @default(false)
  excludedAt             DateTime?
  exclusionReason        String?
  metadata               Json?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([supplierOrganizationId, metricCode, sourceEntityType, sourceEntityId])
  @@index([supplierOrganizationId, metricCode, occurredAt])
  @@index([categoryId, cityId, occurredAt])
}

model SupplierTrustSnapshot {
  id                     String                @id @default(uuid()) @db.Uuid
  supplierOrganizationId String                @unique @db.Uuid
  status                 TrustRatingStatus     @default(INSUFFICIENT_DATA)
  score                  Decimal?              @db.Decimal(6, 3)
  confidence             Decimal               @default(0) @db.Decimal(6, 5)
  eventCount             Int                   @default(0)
  reviewCount            Int                   @default(0)
  windowDays             Int                   @default(180)
  indicators             Json
  factors                Json
  recommendations        Json
  formulaVersion         String                @default("trust-v1")
  computedAt             DateTime              @default(now())
  version                Int                   @default(1)
  appeals                SupplierTrustAppeal[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([status, score])
}

model SupplierTrustAppeal {
  id                     String                @id @default(uuid()) @db.Uuid
  snapshotId             String                @db.Uuid
  supplierOrganizationId String                @db.Uuid
  appellantUserId        String                @db.Uuid
  eventIds               String[]              @default([]) @db.Uuid
  status                 TrustAppealStatus     @default(OPEN)
  reason                 String
  evidence               Json?
  decision               String?
  decidedById            String?               @db.Uuid
  decidedAt              DateTime?
  idempotencyKey         String                @unique
  version                Int                   @default(1)
  snapshot               SupplierTrustSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([supplierOrganizationId, status, createdAt])
}

model DeliveryPerformanceEvent {
  id                     String   @id @default(uuid()) @db.Uuid
  supplierOrganizationId String   @db.Uuid
  warehouseId            String?  @db.Uuid
  destinationCityId      String?  @db.Uuid
  shipmentId             String   @unique @db.Uuid
  promisedHours          Int?
  actualHours            Int?
  onTime                 Boolean?
  distanceKm             Decimal? @db.Decimal(10, 2)
  occurredAt             DateTime
  metadata               Json?
  createdAt              DateTime @default(now())

  @@index([supplierOrganizationId, destinationCityId, occurredAt])
  @@index([warehouseId, occurredAt])
}

model RecommendationDecision {
  id                   String   @id @default(uuid()) @db.Uuid
  buyerOrganizationId  String   @db.Uuid
  requestedById        String   @db.Uuid
  productId            String   @db.Uuid
  destinationAddressId String?  @db.Uuid
  mode                 String
  input                Json
  result               Json
  formulaVersion       String   @default("recommend-v1")
  idempotencyKey       String   @unique
  createdAt            DateTime @default(now())

  @@index([buyerOrganizationId, productId, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}

model SearchQueryEvent {
  id              String   @id @default(uuid()) @db.Uuid
  actorId         String?
  organizationId  String?
  query           String
  normalizedQuery String
  matchedAliases  String[] @default([])
  resultCount     Int
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([normalizedQuery, createdAt])
  @@index([resultCount, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String
  responseCode Int?
  responseBody Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}
