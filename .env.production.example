NODE_ENV=production
MFA_ISSUER="DentMarket KZ"
APP_RELEASE=2026.07.17-1
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/marketplace?schema=public&sslmode=require
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379
BACKGROUND_QUEUE_ENABLED=true
BACKGROUND_QUEUE_CONCURRENCY=8

API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=https://admin.example.kz,https://buyer.example.kz,https://supplier.example.kz,https://example.kz
TRUST_PROXY=true
AUTH_MODE=jwt
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE\n-----END PUBLIC KEY-----
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----
JWT_ISSUER=https://api.example.kz
JWT_AUDIENCE=dentmarket-kz
JWT_REQUIRE_MFA=true
SOCIAL_AUTH_ENABLED=true
GOOGLE_CLIENT_IDS=replace.apps.googleusercontent.com
APPLE_CLIENT_IDS=kz.example.web
AUTH_COOKIE_DOMAIN=.example.kz

INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_32_BYTE_SECRET
APP_SECURITY_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_32_BYTE_SECRET
OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.kz
S3_REGION=kz-ala-1
S3_BUCKET=dentmarket-production
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_AT_LEAST_16
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
AV_SCAN_MODE=required
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

SIGNATURE_GATEWAY_URL=https://eds-provider.example.kz/api
SIGNATURE_CALLBACK_SECRET=REPLACE_WITH_32_BYTE_SECRET
PAYMENT_PROVIDER_MODE=external
PAYMENT_GATEWAY_URL=https://psp.example.kz/marketplace
PAYMENT_GATEWAY_TOKEN=REPLACE_WITH_PROVIDER_TOKEN
PAYMENT_WEBHOOK_SECRET_EXTERNAL=REPLACE_WITH_PROVIDER_WEBHOOK_SECRET
EMAIL_PROVIDER_URL=https://email.example.kz/send
EMAIL_PROVIDER_TOKEN=REPLACE_WITH_PROVIDER_TOKEN
SMS_PROVIDER_URL=https://sms.example.kz/send
SMS_PROVIDER_TOKEN=REPLACE_WITH_PROVIDER_TOKEN
NOTIFICATION_WEBHOOK_SECRET=REPLACE_WITH_32_BYTE_SECRET

OTEL_SERVICE_NAME=marketplace-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.kz/v1/traces
SENTRY_DSN=https://public@example.ingest.sentry.io/1
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

OPENAI_API_KEY=REPLACE
OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL
OPENAI_BASE_URL=https://api.openai.com/v1

REGISTRY=ghcr.io/OWNER
LANDING_DOMAIN=example.kz
ADMIN_DOMAIN=admin.example.kz
BUYER_DOMAIN=buyer.example.kz
SUPPLIER_DOMAIN=supplier.example.kz
API_DOMAIN=api.example.kz
