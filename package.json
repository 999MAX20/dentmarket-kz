{
  "name": "dental-procurement-platform",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "postinstall": "pnpm --filter @marketplace/api prisma:generate",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test --concurrency=2",
    "test:all": "pnpm test && pnpm --filter @marketplace/e2e e2e",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @marketplace/api prisma:generate",
    "db:migrate": "pnpm --filter @marketplace/api prisma:migrate",
    "db:seed": "pnpm --filter @marketplace/api prisma:seed",
    "catalog:import:medstom": "node scripts/import-medstom-catalog.mjs",
    "catalog:build-public": "node scripts/build-public-catalog-fallback.mjs",
    "catalog:report-quality": "node scripts/report-public-catalog-quality.mjs",
    "catalog:bootstrap-canonical": "node scripts/bootstrap-canonical-catalog.mjs",
    "catalog:sync-production": "node scripts/sync-public-catalog-to-production.mjs",
    "catalog:sync-production:apply": "node scripts/sync-public-catalog-to-production.mjs --apply",
    "verify:supplier-cycle:medstom": "node scripts/verify-medstom-supplier-cycle.mjs",
    "verify:supplier-cycle:pdf": "node scripts/verify-pdf-supplier-cycle.mjs",
    "verify:supplier-cycle:csv": "node scripts/verify-csv-supplier-cycle.mjs",
    "verify:document-compliance": "node scripts/verify-document-compliance.mjs",
    "verify:search-commerce": "node scripts/verify-search-commerce.mjs",
    "verify:trust-geo": "node scripts/verify-trust-geo.mjs",
    "verify:onboarding-agreement": "node scripts/verify-onboarding-agreement.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:security-storage": "pnpm --filter @marketplace/api exec node ../../scripts/verify-security-storage.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:production-connectors": "node scripts/verify-production-connectors.mjs",
    "load-test:search": "node scripts/load-test-search.mjs",
    "load-test:handoff": "node scripts/load-test-handoff.mjs",
    "verify:release": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:production-config",
    "verify:web": "pnpm --filter @marketplace/e2e e2e",
    "test:containers": "RUN_TESTCONTAINERS=1 pnpm --filter @marketplace/api test -- postgres-concurrency.testcontainers.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prisma/client": "^6.19.0",
    "@types/node": "^24.0.0",
    "next": "16.2.10",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/core": "^11.1.28",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2"
  }
}
